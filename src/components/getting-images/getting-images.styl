.getting-images-container {
  position relative
  display flex
  align-items center
  justify-content center
  box-sizing border-box
  width 100%
  height 300px
  color var(--picx-color-text-muted)
  background var(--picx-color-surface)
  border 2px dashed var(--picx-color-control-border)
  border-radius var(--picx-radius-control)

  &.focus
  &.dragging {
    border-color var(--picx-color-primary)
  }

  &.disabled {
    opacity .65
  }

  input[type="file"] {
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip-path inset(50%)
  }

  .preview-select {
    position absolute
    z-index 1
    width 100%
    height 100%
    cursor pointer
  }

  .upload-area-tips {
    text-align center

    .text {
      margin-top 12px
      font-size 16px
    }
  }

  .preview-img
  .preview-video {
    width 100%
    height 100%
    object-fit contain
  }

  &.workspace {
    flex-direction column
    gap 12px
    min-height 0
    height 100%
    padding 20px 24px
    text-align center
    border-width 1px
    border-radius 24px

    &.has-items {
      justify-content flex-start
    }

    p {
      margin 0
      font-size 14px
      line-height 1.6
    }

    .upload-symbol {
      display grid
      flex-shrink 0
      place-items center
      width 48px
      height 48px
      color var(--picx-color-primary)
      background var(--picx-color-primary-soft)
      border-radius var(--picx-radius-control)
    }

    .thumb-grid {
      display grid
      grid-template-columns repeat(auto-fill, minmax(56px, 1fr))
      gap 8px
      width 100%
      max-height 128px
      overflow-y auto

      .thumb {
        width 100%
        aspect-ratio 1
        object-fit cover
        border-radius 8px
        background var(--picx-color-surface-muted)
      }
    }

    .el-button {
      gap 10px
      min-height 48px
      height auto
      padding 12px 24px
      white-space normal

      :deep(> span) {
        gap 10px
      }
    }

    @media (max-width 767px) {
      padding 16px
    }
  }
}
