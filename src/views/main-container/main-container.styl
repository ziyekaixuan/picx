.main-container {
  display flex
  flex-direction column
  box-sizing border-box
  width 100%
  min-height 100dvh
  color var(--picx-color-text)
  background var(--picx-color-bg)

  .main-content {
    flex 1
    box-sizing border-box
    min-height 0
    width 100%
    max-width calc(var(--picx-content-max-width) + 64px)
    margin 0 auto
    padding 32px

    :deep(.page-container) {
      border-radius var(--picx-radius-card)
    }
  }

  @media (min-width 768px) and (max-width 1279px) {
    .main-content {
      padding 24px
    }
  }

  @media (max-width $picx-mobile-breakpoint) {
    .main-content {
      padding 24px 16px

      :deep(.page-container) {
        padding 16px
      }
    }
  }

  .back-to-top {
    display flex
    position fixed
    z-index var(--picx-layer-header)
    right 20px
    bottom 24px
    align-items center
    justify-content center
    width 48px
    height 48px
    padding 0
    border 1px solid var(--picx-color-border)
    border-radius 50%
    background var(--picx-color-surface)
    box-shadow 0 6px 20px var(--picx-color-shadow)
    color var(--picx-color-primary)
    font inherit
    cursor pointer
    opacity 0
    transform translateY(12px)
    transition opacity var(--picx-duration) ease, transform var(--picx-duration) ease
    pointer-events none

    &.visible {
      opacity 1
      transform translateY(0)
      pointer-events auto
    }

    &:hover {
      background var(--picx-color-primary-soft)
    }
  }
}
