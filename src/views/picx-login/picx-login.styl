.login-container {
  max-width 1064px
  margin 0 auto
  color var(--picx-color-text)
  font-size 14px

  h1
  h2
  p {
    margin 0
  }

  .connection-intro {
    margin 8px 0 24px
    text-align center

    h1 {
      font-size 32px
      line-height 1.5
    }

    > p {
      margin-top 12px
      color var(--picx-color-text-muted)
      font-size 16px
      line-height 1.6
    }
  }

  .connection-card {
    display flex
    flex-direction column
    box-sizing border-box
    max-width 560px
    margin 0 auto
    padding 28px 32px
    background var(--picx-color-surface)
    border 1px solid var(--picx-color-border)
    border-radius 24px

    h2 {
      margin 20px 0 12px
      font-size 24px
      font-weight 600
      line-height 1.5
    }

    p {
      color var(--picx-color-text-muted)
      line-height 1.6
    }
  }

  .card-heading {
    display flex
    align-items center
    justify-content space-between
    min-height 52px
  }

  .login-icon {
    display grid
    width 52px
    height 52px
    place-items center
    color var(--picx-color-text)
    background var(--picx-color-primary-soft)
    border-radius 16px
  }

  .token-field {
    margin-top 20px

    label {
      display block
      margin-bottom 8px
      font-weight 500
    }
  }

  .token-input-wrap {
    display flex
    align-items center
    box-sizing border-box
    min-height 48px
    padding 0 2px 0 14px
    border 1px solid var(--picx-color-control-border)
    border-radius 10px

    &:focus-within {
      outline 2px solid var(--picx-color-focus)
      outline-offset 2px
    }

    &.invalid {
      border-color var(--picx-color-danger)
    }

    input {
      flex 1
      min-width 0
      min-height 44px
      padding 0
      color var(--picx-color-text)
      font-size 14px
      background transparent
      border 0

      &:focus-visible {
        outline none
      }
    }
  }

  .login-actions {
    margin-top auto
    padding-top 28px

    .el-button {
      width 100%
      min-height 48px
      margin 0
      white-space normal

      :deep(> span) {
        gap 8px
      }
    }
  }

  .login-links {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap 4px 16px
    margin-top 12px

    a {
      display inline-flex
      align-items center
      min-height 44px
      color var(--picx-color-primary)
      line-height 1.5

      &:hover {
        text-decoration underline
      }
    }
  }

  .connection-error {
    margin-top 12px
    color var(--picx-color-danger) !important
    line-height 1.6
  }

  .login-container__account {
    display flex
    align-items center
    justify-content center
    gap 8px
    margin-top 20px
    color var(--picx-color-text)
    font-size 16px
    font-weight 500
    line-height 1.6

    .picx-icon {
      flex-shrink 0
    }

    span {
      min-width 0
      overflow-wrap anywhere
    }
  }

  .connection-progress {
    margin-top 16px
    color var(--picx-color-primary)
    text-align center
  }

  @media (max-width 767px) {
    .connection-intro {
      margin 0 0 24px

      h1 {
        font-size 28px
      }
    }

    .connection-card {
      padding 24px

      h2 {
        font-size 22px
      }
    }

    .token-input-wrap input {
      font-size 16px
    }
  }
}
